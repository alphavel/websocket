{
    "name": "alphavel/websocket",
    "description": "High-performance WebSocket server with broadcasting for Alphavel Framework",
    "keywords": ["websocket", "swoole", "broadcasting", "real-time", "alphavel", "performance"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Alphavel Team",
            "email": "team@alphavel.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "alphavel/alphavel": "^1.0",
        "ext-swoole": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Alphavel\\WebSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alphavel\\WebSocket\\Tests\\": "tests/"
        }
    },
    "extra": {
        "alphavel": {
            "providers": [
                "Alphavel\\WebSocket\\WebSocketServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
